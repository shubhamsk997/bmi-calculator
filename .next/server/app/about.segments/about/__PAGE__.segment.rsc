0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"[{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://example.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"BMI Guide: a useful screen, not the whole story\",\"item\":\"https://example.com/about\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"BMI Guide: a useful screen, not the whole story\",\"description\":\"Understand Body Mass Index, how it is calculated, and how to use it thoughtfully alongside other markers of health.\",\"author\":{\"@type\":\"Person\",\"name\":\"Elena Morris, CHCW\"},\"reviewedBy\":{\"@type\":\"Person\",\"name\":\"Dr. Daniel Chen, MD\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"BMI Index Calculator\"},\"dateModified\":\"2026-07-24\"}]"}}],["$","section",null,{"className":"bg-mint py-16 dark:bg-teal-950","children":["$","div",null,{"className":"container max-w-4xl","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-widest text-teal-700","children":"BMI Index Calculator · Health guide"}],["$","h1",null,{"className":"mt-4 text-4xl font-extrabold tracking-tight md:text-5xl","children":"BMI Guide: a useful screen, not the whole story"}],["$","p",null,{"className":"mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300","children":"Understand Body Mass Index, how it is calculated, and how to use it thoughtfully alongside other markers of health."}],["$","p",null,{"className":"mt-5 text-sm text-slate-500","children":["Written by ","Elena Morris, CHCW"," · Medically reviewed by ","Dr. Daniel Chen, MD"," · Updated July 24, 2026"]}]]}]}],["$","$L2",null,{"title":"","children":["$","article",null,{"className":"prose-health max-w-4xl","children":[[["$","$L3",null,{"children":[["$","strong",null,{"children":"Short answer:"}]," BMI compares weight with height. It is useful for screening adult population health, but it does not directly measure body fat or diagnose disease."]}],["$","h2",null,{"children":"How BMI became a common health measure"}],["$","p",null,{"children":"Health services use BMI because height and weight are straightforward to measure and the relationship between BMI categories and health outcomes has been studied in large populations. It helps identify people who may benefit from a closer look at cardiometabolic health."}],["$","h2",null,{"children":"Formula and categories"}],["$","p",null,{"children":"Divide kilograms by metres squared, or use pounds × 703 ÷ inches squared. For adults, below 18.5 is underweight; 18.5–24.9 is healthy weight; 25–29.9 is overweight; and 30 or above is obesity. These labels describe screening ranges, not character or diagnosis."}],["$","h2",null,{"children":"Use BMI alongside context"}],["$","p",null,{"children":"A clinician may also ask about blood pressure, waist circumference, sleep, medications, family history, movement, nutrition, and recent changes. This broader view is especially useful for athletes, older adults, and people whose body composition differs from average."}],["$","h2",null,{"children":"Where to go next"}],["$","p",null,{"children":"Use our calculator for a real-time result, then bring questions to a clinician if the result is unexpected or you have symptoms. Sustainable habits—regular meals, strength and aerobic activity, restorative sleep, and supportive care—matter at every BMI."}]],["$","p",null,{"className":"mt-10 rounded-xl bg-slate-100 p-4 text-sm dark:bg-slate-800","children":["This material is for education and does not replace personal medical advice. ","$L4"]}]]}]}]],["$L5"],"$L6"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"zGaTm9otQK25VABIhSGDn"}
