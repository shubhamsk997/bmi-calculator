b:["$","h2",null,{"children":"Adults"}]
c:["$","p",null,{"children":"From age 18, the standard category thresholds remain the same. A person’s health context can change over time, so the meaning of a BMI should always be individualized."}]
d:["$","h2",null,{"children":"Older adults"}]
e:["$","p",null,{"children":"Later life can bring loss of muscle mass and changes in appetite. Preventing unintentional weight loss, maintaining strength, and protecting mobility may take priority over pursuing a low BMI."}]
f:["$","h2",null,{"children":"Children and teenagers"}]
10:["$","p",null,{"children":"Growing bodies require a different approach. Parents should use paediatric growth charts and discuss concerns with a paediatric clinician rather than applying an adult calculator."}]
