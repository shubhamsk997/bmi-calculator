a:["$","div",null,{"className":"container grid gap-10 py-16 md:grid-cols-[1.05fr_.95fr] md:py-24","children":[["$","div",null,{"className":"self-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-[.18em] text-teal-700","children":"Evidence-informed health screening"}],["$","h1",null,{"className":"mt-4 text-5xl font-extrabold tracking-[-.055em] md:text-6xl","children":"BMI Calculator for clear, practical health context."}],["$","p",null,{"className":"mt-6 max-w-xl text-lg leading-8 text-slate-600","children":"Calculate your Body Mass Index in seconds, understand the adult BMI category, and see the weight range associated with your height."}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-3","children":[["$","$L5",null,{"href":"/bmi-calculator","className":"rounded-xl bg-teal-700 px-5 py-3 font-bold text-white shadow-lg shadow-teal-900/15","children":"Calculate your BMI"}],["$","a",null,{"href":"#guide","className":"rounded-xl border border-slate-300 bg-white px-5 py-3 font-bold","children":"Read the BMI guide"}]]}],["$","p",null,{"className":"mt-6 text-xs text-slate-500","children":"For adults 18+. Educational use only; not a medical diagnosis."}]]}],["$","div",null,{"className":"card p-4 sm:p-6","children":[["$","h2",null,{"className":"text-xl font-bold","children":"Quick BMI calculator"}],["$","p",null,{"className":"mt-1 text-sm text-slate-500","children":"Results update as you type."}],["$","div",null,{"className":"mt-5","children":["$","$L15",null,{"compact":true}]}]]}]]}]
b:["$","$L16",null,{"eyebrow":"Why use it","title":"A simple number, used with good judgment.","children":["$","div",null,{"className":"mt-9 grid gap-5 md:grid-cols-3","children":[["$","div","Fast, unit-flexible calculation",{"className":"card p-6","children":[["$","$L17",null,{"ref":"$undefined","iconNode":[["path",{"d":"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2","key":"169zse"}]],"className":"lucide-activity text-teal-700"}],["$","h3",null,{"className":"mt-5 text-lg font-bold","children":"Fast, unit-flexible calculation"}],["$","p",null,{"className":"mt-2 leading-7 text-slate-600 dark:text-slate-300","children":"Use centimetres and kilograms, or feet, inches, and pounds. Your result appears without a page reload."}]]}],["$","div","More than a category",{"className":"card p-6","children":[["$","$L17",null,{"ref":"$undefined","iconNode":[["path",{"d":"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5","key":"mvr1a0"}],["path",{"d":"M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27","key":"auskq0"}]],"className":"lucide-heart-pulse text-teal-700"}],["$","h3",null,{"className":"mt-5 text-lg font-bold","children":"More than a category"}],["$","p",null,{"className":"mt-2 leading-7 text-slate-600 dark:text-slate-300","children":"See the healthy-weight range for your height alongside a plain-language explanation of what BMI can and cannot say."}]]}],["$","div","Privacy-minded by design",{"className":"card p-6","children":[["$","$L17",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check text-teal-700"}],["$","h3",null,{"className":"mt-5 text-lg font-bold","children":"Privacy-minded by design"}],["$","p",null,{"className":"mt-2 leading-7 text-slate-600 dark:text-slate-300","children":"Recent results remain in your browser. We do not ask for a name, account, or health record."}]]}]]}]}]
c:["$","$L16",null,{"eyebrow":"The essential answer","title":"What is BMI?","children":[["$","$L18",null,{"children":[["$","strong",null,{"children":"Body Mass Index (BMI)"}]," is a weight-for-height screening measure. For adults, it is calculated from weight and height and grouped into broad categories that can help flag possible health risk. It does not measure body fat directly."]}],["$","article",null,{"id":"guide","className":"prose-health mt-8 max-w-4xl","children":[["$","p",null,{"children":"BMI is one of the most familiar numbers in preventive health. It is used in clinics, public-health research, and everyday healthy weight calculators because it is inexpensive, reproducible, and easy to understand. The number is useful precisely because it is simple: it relates body weight to height. But that simplicity is also its limit. A BMI result is a starting point for a conversation about health, not a verdict on a person’s health, appearance, or worth."}],["$","h2",null,{"children":"BMI formula: metric and imperial"}],["$","p",null,{"children":"The metric BMI formula is weight in kilograms divided by height in metres squared. If someone weighs 70 kg and is 1.70 m tall, their calculation is 70 ÷ (1.70 × 1.70), or 24.2. The imperial formula uses pounds and inches: weight in pounds × 703 ÷ height in inches squared. Both produce the same BMI Index when the measurements are converted correctly."}],["$","div",null,{"className":"overflow-x-auto","children":["$","table",null,{"className":"mt-5 w-full border-collapse text-left text-sm","children":[["$","thead",null,{"children":["$","tr",null,{"className":"border-b","children":[["$","th",null,{"className":"p-3","children":"Adult BMI"}],["$","th",null,{"className":"p-3","children":"Category"}],["$","th",null,{"className":"p-3","children":"General interpretation"}]]}]}],["$","tbody",null,{"children":[["$","tr","Below 18.5",{"className":"border-b","children":[["$","td","Below 18.5",{"className":"p-3","children":"Below 18.5"}],["$","td","Underweight",{"className":"p-3","children":"Underweight"}],["$","td","May need individual assessment",{"className":"p-3","children":"May need individual assessment"}]]}],["$","tr","18.5–24.9",{"className":"border-b","children":[["$","td","18.5–24.9",{"className":"p-3","children":"18.5–24.9"}],["$","td","Healthy weight",{"className":"p-3","children":"Healthy weight"}],["$","td","Generally lowest population-level risk",{"className":"p-3","children":"Generally lowest population-level risk"}]]}],["$","tr","25.0–29.9",{"className":"border-b","children":[["$","td","25.0–29.9",{"className":"p-3","children":"25.0–29.9"}],["$","td","Overweight",{"className":"p-3","children":"Overweight"}],["$","td","Potentially increased risk",{"className":"p-3","children":"Potentially increased risk"}]]}],["$","tr","30.0 and above",{"className":"border-b","children":[["$","td","30.0 and above",{"className":"p-3","children":"30.0 and above"}],["$","td","Obesity",{"className":"p-3","children":"Obesity"}],["$","td","Increased risk; support may help",{"className":"p-3","children":"Increased risk; support may help"}]]}]]}]]}]}],["$","h2",null,{"children":"Why clinicians use BMI categories"}],["$","p",null,{"children":"At the population level, BMI categories are associated with different rates of conditions such as type 2 diabetes, high blood pressure, sleep apnoea, and cardiovascular disease. This makes BMI a helpful first screen. In an individual appointment, a clinician may pair it with blood pressure, blood tests, waist circumference, family history, medications, diet, physical activity, and the direction of weight change over time."}],["$","p",null,{"children":"A single BMI cannot tell you whether you have a medical condition. Nor can it tell you where weight is carried. Abdominal fat is particularly relevant to cardiometabolic risk, which is why a waist measurement can be helpful. If your BMI result is unexpected, sudden, or worrying, it deserves context rather than self-judgment."}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
d:["$","$L16",null,{"eyebrow":"Answers, plainly stated","title":"BMI calculator FAQs","children":["$","$L2a",null,{"items":[{"q":"What is a healthy BMI for adults?","a":"For most adults, a BMI from 18.5 to 24.9 is classified as healthy weight. BMI is a screening tool, so a clinician may also consider waist circumference, medical history, fitness, and other measures."},{"q":"How is BMI calculated?","a":"Metric BMI is weight in kilograms divided by height in metres squared. In imperial units, multiply weight in pounds by 703 and divide by height in inches squared."},{"q":"Is BMI accurate for athletes?","a":"It can be less informative for very muscular people because BMI cannot distinguish muscle from fat. Body composition, waist measurement, and clinical assessment can add useful context."},{"q":"Can children use this calculator?","a":"No. Children and teens use BMI-for-age percentiles that account for age and sex, rather than adult BMI categories."},{"q":"Does BMI differ for men and women?","a":"The standard adult cutoffs are the same. However, body composition and health risk can differ by sex, age, ethnicity, and individual health factors."}]}]}]
e:["$","$L16",null,{"eyebrow":"Editorial standards","title":"Reviewed health information, with sources.","children":["$","div",null,{"className":"prose-health max-w-4xl","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Written by Elena Morris, Certified Health Content Writer."}]," Medically reviewed by ",["$","strong",null,{"children":"Dr. Daniel Chen, MD"}],", a licensed physician. Last reviewed July 24, 2026. Our editorial process prioritizes primary public-health guidance and clinically established sources; medical content is reviewed for accuracy and updated when guidance changes."]}],["$","h3",null,{"children":"References"}],["$","ul",null,{"children":[["$","li",null,{"children":["$","a",null,{"href":"https://www.cdc.gov/bmi/about/index.html","className":"text-teal-700 underline","children":"Centers for Disease Control and Prevention: About BMI"}]}],["$","li",null,{"children":["$","a",null,{"href":"https://www.who.int/data/gho/data/themes/topics/topic-details/GHO/body-mass-index","className":"text-teal-700 underline","children":"World Health Organization: Body mass index"}]}],["$","li",null,{"children":["$","a",null,{"href":"https://www.nhs.uk/common-health-questions/lifestyle/what-is-the-body-mass-index-bmi/","className":"text-teal-700 underline","children":"NHS: What is BMI?"}]}]]}]]}]}]
