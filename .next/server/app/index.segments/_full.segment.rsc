9:T652,[{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a healthy BMI for adults?","acceptedAnswer":{"@type":"Answer","text":"For most adults, a BMI from 18.5 to 24.9 is classified as healthy weight. BMI is a screening tool, so a clinician may also consider waist circumference, medical history, fitness, and other measures."}},{"@type":"Question","name":"How is BMI calculated?","acceptedAnswer":{"@type":"Answer","text":"Metric BMI is weight in kilograms divided by height in metres squared. In imperial units, multiply weight in pounds by 703 and divide by height in inches squared."}},{"@type":"Question","name":"Is BMI accurate for athletes?","acceptedAnswer":{"@type":"Answer","text":"It can be less informative for very muscular people because BMI cannot distinguish muscle from fat. Body composition, waist measurement, and clinical assessment can add useful context."}},{"@type":"Question","name":"Can children use this calculator?","acceptedAnswer":{"@type":"Answer","text":"No. Children and teens use BMI-for-age percentiles that account for age and sex, rather than adult BMI categories."}},{"@type":"Question","name":"Does BMI differ for men and women?","acceptedAnswer":{"@type":"Answer","text":"The standard adult cutoffs are the same. However, body composition and health risk can differ by sex, age, ethnicity, and individual health factors."}}]},{"@context":"https://schema.org","@type":"MedicalWebPage","name":"BMI Calculator","url":"https://example.com","about":{"@type":"MedicalCondition","name":"Body weight assessment"},"lastReviewed":"2026-07-24"}]0:{"P":null,"c":["",""],"q":"","i":false,"f":[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",16],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/2_1vjn3lrabul.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/1ucbb_a5w122m.js","async":tr